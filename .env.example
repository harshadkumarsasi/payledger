# Local development database (docker compose up -d)
DATABASE_URL=postgres://payledger:payledger@localhost:5432/payledger

# Isolated database used by the Vitest suite (docker compose up -d)
TEST_DATABASE_URL=postgres://payledger:payledger@localhost:5433/payledger_test

# Production (Vercel) uses Neon. Copy the *pooled* connection string from the
# Neon dashboard, including `?sslmode=require`, into the Vercel project env:
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/payledger?sslmode=require
